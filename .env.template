# Copy this file to .env and replace the required values.
# Keep secrets, access tokens, and private-key contents out of this file.

# Microsoft Foundry model used by the workflow agents.
FOUNDRY_PROJECT_ENDPOINT= # [required always, full Foundry project endpoint URL including /api/projects/<project-name>]
FOUNDRY_MODEL_DEPLOYMENT= # [required always, Foundry model deployment name used by the workflow agents]

# Decision model endpoint and response contract.
DECISION_ENDPOINT= # [required always, full Decision model provider endpoint URL]
DECISION_MODEL_DEPLOYMENT= # [required always, Decision model deployment identifier sent in each request]
DECISION_MODEL_NAME= # [required always, canonical Decision model name stored in the provider configuration]
DECISION_RESPONSE_MODEL= # [required always, exact model identifier expected in Decision provider responses]
DECISION_REQUESTS_PER_MINUTE= # [required always, positive per-process request limit used for local admission control]
LLM_TIMEOUT_S= # [required always, request timeout in seconds; must be greater than 0 and no more than 300]


## The below are used when you are running this on a remote Azure VM i.e. you ran
## ./setup-vm.sh first and have a target Ubuntu VM in Azure near your Foundry.

# Azure context used by the remote VM helper scripts.
AZURE_RESOURCE_GROUP= # [required for remote Azure VM, resource group containing the VM; alternatively pass --resource-group]
AZURE_VM_NAME= # [required for remote Azure VM, name of the Azure Linux VM; alternatively pass --vm-name]
AZURE_SUBSCRIPTION_ID= # [optional, Azure subscription ID or name; remote scripts use the active Azure CLI subscription when empty]
AZURE_TENANT_ID= # [optional, Microsoft Entra tenant ID used by the documented local az login command]

# Remote VM connection and execution settings.
VM_LOCAL_USER= # [required for remote Azure VM, name of the local Linux user on the VM]
VM_PRIVATE_KEY_FILE= # [required for remote Azure VM, WSL path to the SSH private-key file; alternatively pass --private-key-file]
VM_REMOTE_DIR= # [required for remote Azure VM execution, destination directory where the workflow files are copied]
VM_PREFER_PRIVATE_IP=false # [optional for remote Azure VM, true to connect through the VM private IP; defaults to false]
VM_LOGIN_WITH_MANAGED_IDENTITY=false # [optional for remote Azure VM setup, true to run az login --identity on the VM; defaults to false]

